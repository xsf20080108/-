# 密钥与凭据（含真实 API Key，严禁提交）
.env
.streamlit/
credentials.toml

# 内置 Python 运行时（约 633MB 二进制，不入库，走 Release 分发）
runtime/

# Python 编译产物
__pycache__/
*.pyc
*.pyo
*.pyd

# 评估中间产物（非最终版）
output/kr1/
output/kr1_v2/
output/kr1_v3/
output/kr1_final/
output/*.json
output/*.md

# KR2/KR3 评估产物（由 consistency.py / human_review.py 一键生成）
output/kr2/
output/review/
output/kr2_gold.template.json

# module e 问答库（12MB 大数据，可由 python -m modules.e.qa_base 一键重建）
output/qa/

# 本机临时生成物
*.guidance.json
*.guidance.md
*.guidance.scores.json
*.pain_points.json
*.enhance.json
*.enhance.md

# PPT 工具缓存
答辩PPT/.slidep/
答辩PPT/assets/

# 系统/编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# 理赔触发运行日志/反馈（含案件流水，非源码）
output/*.jsonl

# 本机专属启动脚本（含本机 Python 绝对路径，不入库）
启动_workbuddy.bat

# 日志文件
*.log
